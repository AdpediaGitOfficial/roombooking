# Copy to .env and adjust. Matches docker-compose.yml defaults.
# The web app, API and worker all read this file (in production, set the same
# values in each service's environment). See docs/deployment.md.
DATABASE_URL="postgresql://sam:sam@localhost:5432/sam?schema=public"
# In production add &connection_limit=10 (connections per API/worker process), and
# &pgbouncer=true when going through PgBouncer (deploy/pgbouncer.ini.example).

# Services
# WEB_PORT=3000                      # the web app listens here (used by PM2: ecosystem.config.cjs)
# API_PORT=4000                      # the API listens here
API_URL=http://127.0.0.1:4000        # where the web app reaches the API (a public https address also works)
# API_HOST=0.0.0.0                   # use 127.0.0.1 when only nginx/web on the same server calls it
# API_TIMEOUT_MS=30000               # web -> API request timeout
# TRUST_PROXY=true                   # trust X-Forwarded-For (the web app forwards the visitor's address)
# CORS_ORIGINS=                      # comma-separated origins allowed to call the API from a browser (none by default)
# RATE_LIMIT_MAX=1200                # requests per client address per window
# RATE_LIMIT_WINDOW_SECONDS=60
# READ_CACHE_TTL_MS=5000             # shared dashboard/pick-list cache per API process; 0 = off
# SESSION_CACHE_TTL_MS=10000         # reuse a verified session for this long; 0 = check every request
# METRICS_TOKEN=                     # protects GET /metrics on the API when set
# LOG_LEVEL=info

# Authentication
SESSION_TTL_HOURS=12            # absolute session lifetime
LOGIN_MAX_FAILED_ATTEMPTS=5     # failures before temporary lockout
LOGIN_LOCKOUT_MINUTES=15
# SEED_PASSWORD=ChangeMe123!    # password for the demo users created by db:seed

# Maintenance
UPLOAD_DIR=uploads             # photos are stored here, outside the database
MAX_UPLOAD_BYTES=5242880
MAINTENANCE_REOPEN_WINDOW_DAYS=7

# User administration
INVITE_TTL_HOURS=168           # invite links expire after 7 days
RESET_TTL_HOURS=24

# Email delivery (COM-01). EMAIL_TRANSPORT=smtp|log|disabled; defaults to smtp when SMTP_HOST is set, else log.
APP_BASE_URL=http://localhost:3000   # used in email links
# EMAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM="Staff Accommodation <no-reply@example.com>"
EMAIL_FANOUT=true                    # also email in-app notifications
EMAIL_MAX_ATTEMPTS=5
# Worker timings (EMAIL_WORKER_INTERVAL_SECONDS is the old name for OUTBOX_INTERVAL_SECONDS)
OUTBOX_INTERVAL_SECONDS=20           # how often queued email/WhatsApp messages are sent
SWEEP_INTERVAL_SECONDS=60            # how often reminders, escalations and expiries run
# WORKER_HEALTH_PORT=4200            # worker GET /health
# JOBS_SECRET=change-me               # bearer token for POST /jobs/run on the API (and /api/jobs/notifications on the web app)

# WhatsApp delivery (COM-02, COM-04). WHATSAPP_TRANSPORT=meta|log|disabled; defaults to meta when WHATSAPP_ACCESS_TOKEN is set, else disabled.
# WHATSAPP_TRANSPORT=log
# WHATSAPP_ACCESS_TOKEN=               # Meta Cloud API system-user token
# WHATSAPP_PHONE_NUMBER_ID=            # the business phone number id, not the number
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_VERIFY_TOKEN=change-me      # webhook verification (GET /api/webhooks/whatsapp)
# WHATSAPP_APP_SECRET=                 # verifies X-Hub-Signature-256 on delivery receipts
WHATSAPP_FANOUT=true                 # also WhatsApp in-app notifications to people who opted in
WHATSAPP_LANGUAGE=en                 # template language code
WHATSAPP_TEMPLATE_PREFIX=sam_        # approved template names are <prefix><name>, see /admin/notifications?channel=WHATSAPP
# WHATSAPP_TEMPLATE_MAP={"allocation.confirmed":"my_custom_template"}
# DEFAULT_COUNTRY_CODE=971            # lets residents enter local numbers (050…)

# nginx in front of the web service. Copy to /etc/nginx/sites-available/, edit the
# domain, then `certbot --nginx -d accommodation.example.com` adds HTTPS.
#
# Only the web service is public. The API (port 4000) and worker (4200) listen on
# 127.0.0.1 and are reached by the web service, never by browsers.

# Optional: several API machines. Point API_URL for the web service at
# http://127.0.0.1:4010 and list every API instance here; nginx spreads the load
# and skips an instance whose /ready fails. With one machine, keep API_URL at
# http://127.0.0.1:4000 and delete this block and the 4010 server.
upstream sam_api {
    least_conn;
    server 127.0.0.1:4000 max_fails=3 fail_timeout=10s;
    # server 10.0.0.12:4000 max_fails=3 fail_timeout=10s;
    keepalive 64;
}

server {
    listen 127.0.0.1:4010;
    location / {
        proxy_pass         http://sam_api;
        proxy_http_version 1.1;
        proxy_set_header   Connection "";
        proxy_set_header   Host $host;
        proxy_set_header   X-Forwarded-For $http_x_forwarded_for;   # keep the visitor's address from the web service
        proxy_next_upstream error timeout http_502 http_503;
        client_max_body_size 12m;
    }
}

server {
    listen 80;
    server_name accommodation.example.com;
    client_max_body_size 12m;          # photo uploads pass through to the API

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /_next/static/ {
        proxy_pass         http://127.0.0.1:3000;
        proxy_set_header   Host $host;
        add_header         Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass         http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}

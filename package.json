{
  "name": "staff-accommodation",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @sam/web",
    "dev:web": "npm run dev -w @sam/web",
    "dev:api": "npm run dev -w @sam/api",
    "dev:worker": "npm run dev -w @sam/worker",
    "build": "npm run db:generate && npm run build --workspaces --if-present",
    "start": "npm run start -w @sam/web",
    "start:web": "npm run start -w @sam/web",
    "start:api": "npm run start -w @sam/api",
    "start:worker": "npm run start -w @sam/worker",
    "lint": "eslint",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "prisma generate --schema packages/core/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/core/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema packages/core/prisma/schema.prisma",
    "db:seed": "tsx packages/core/prisma/seed.ts",
    "db:studio": "prisma studio --schema packages/core/prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema packages/core/prisma/schema.prisma",
    "jobs": "node scripts/jobs.mjs",
    "postinstall": "npm run db:generate",
    "loadtest:data": "node --env-file-if-exists=.env scripts/loadtest/generate-data.cjs",
    "loadtest:tokens": "tsx scripts/loadtest/tokens.mts",
    "loadtest:bench": "node scripts/loadtest/bench.mjs",
    "loadtest:simulate": "node scripts/loadtest/simulate.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "autocannon": "^8.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}

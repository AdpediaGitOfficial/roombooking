// Staff Accommodation Management – core data model.
// Mirrors section 4 (Core Data Model) and section 8 (Status Models) of the SRS.
// Integrity rules that Prisma cannot express (date-range exclusion on bed
// allocations, partial unique indexes, append-only audit) live in
// prisma/migrations/*/migration.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organisation and accommodation hierarchy
// ---------------------------------------------------------------------------

enum RecordStatus {
  ACTIVE
  INACTIVE
}

model Organization {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  sites        Site[]
  users        User[]
  staff        StaffProfile[]
  vendors      Vendor[]
  requestTypes RequestType[]
}

model Site {
  id             String       @id @default(cuid())
  organizationId String
  code           String
  name           String
  address        String?
  timezone       String       @default("UTC")
  // Accommodation office details shown to residents (SS-02).
  contactPhone   String?
  contactEmail   String?
  helpNotes      String?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id])
  buildings       Building[]
  facilities      Facility[]
  roleAssignments RoleAssignment[]
  keys            Key[]
  inventoryItems  InventoryItem[]
  lostFoundItems  LostFoundItem[]
  workOrders      WorkOrder[]

  @@unique([organizationId, code])
}

enum BuildingType {
  BUILDING
  VILLA
  APARTMENT
}

model Building {
  id        String       @id @default(cuid())
  siteId    String
  code      String
  name      String
  type      BuildingType @default(BUILDING)
  address   String?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  site            Site             @relation(fields: [siteId], references: [id])
  rooms           Room[]
  roleAssignments RoleAssignment[]
  workOrders      WorkOrder[]

  @@unique([siteId, code])
}

enum RoomStatus {
  ACTIVE
  BLOCKED
  INACTIVE
}

enum GenderPolicy {
  ANY
  MALE
  FEMALE
}

// A room is a container for individually tracked bed spaces. Its capacity
// is the number of non-retired beds; occupancy is derived per bed from
// allocations (see src/modules/accommodation/occupancy.ts).
model Room {
  id           String       @id @default(cuid())
  buildingId   String
  code         String
  type         String?
  floor        String?
  genderPolicy GenderPolicy @default(ANY)
  status       RoomStatus   @default(ACTIVE)
  blockReason  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  building              Building               @relation(fields: [buildingId], references: [id])
  beds                  Bed[]
  keys                  Key[]
  inventoryItems        InventoryItem[]
  inventoryTransactions InventoryTransaction[]
  assetAssignments      AssetAssignment[]
  workOrders            WorkOrder[]

  @@unique([buildingId, code])
}

// Configuration state of a bed space. Whether it is occupied is computed
// from allocations, not stored here.
enum BedStatus {
  ACTIVE
  BLOCKED
  RETIRED
}

model Bed {
  id          String    @id @default(cuid())
  roomId      String
  code        String
  status      BedStatus @default(ACTIVE)
  blockReason String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  room        Room         @relation(fields: [roomId], references: [id])
  allocations Allocation[]

  @@unique([roomId, code])
}

// ---------------------------------------------------------------------------
// Users, roles and staff
// ---------------------------------------------------------------------------

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model User {
  id                  String     @id @default(cuid())
  organizationId      String
  email               String     @unique
  name                String
  passwordHash        String?
  passwordChangedAt   DateTime?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  // One-time invite / password-reset token (hash only) with expiry (ADM-01, SS-08).
  tokenHash           String?    @unique
  tokenPurpose        String?
  tokenExpiresAt      DateTime?
  // Resident preference: receive email copies of in-app notifications (COM-01).
  emailNotifications  Boolean    @default(true)
  status              UserStatus @default(INVITED)
  lastLoginAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id])
  roleAssignments RoleAssignment[]
  sessions        Session[]
  staffProfile    StaffProfile?
  vendor          Vendor?          @relation(fields: [vendorId], references: [id])
  vendorId        String?
  accessExpiresAt DateTime?

  requests              Request[]              @relation("RequestRequester")
  approvalDecisions     ApprovalDecision[]
  workOrdersRequested   WorkOrder[]            @relation("WorkOrderRequester")
  workOrdersAssigned    WorkOrder[]            @relation("WorkOrderAssignee")
  workOrderNotes        WorkOrderNote[]
  facilityBookings      FacilityBooking[]
  keyTransactions       KeyTransaction[]
  inventoryTransactions InventoryTransaction[]
  assetAssignments      AssetAssignment[]      @relation("AssetAssignedBy")
  assetAssignmentsEnded AssetAssignment[]      @relation("AssetEndedBy")
  lostFoundCustody      LostFoundItem[]
  notifications         Notification[]
  auditEvents           AuditEvent[]
  attachments           Attachment[]
  allocations           Allocation[]
}

// Server-side sessions (ADM-05). The cookie carries a random token; only its
// SHA-256 hash is stored. Revoking a session or deactivating the user ends
// access on the next request.
model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
}

// Roles from SRS section 3. Permissions are enforced server-side in code;
// a role assignment may be scoped to a site or building.
enum Role {
  SYSTEM_ADMIN
  ACCOMMODATION_ADMIN
  ACCOMMODATION_OFFICER
  STAFF
  APPROVER
  MAINTENANCE
  VENDOR
  INVENTORY_KEY_CUSTODIAN
  FACILITY_MANAGER
  AUDITOR
}

model RoleAssignment {
  id         String   @id @default(cuid())
  userId     String
  role       Role
  siteId     String?
  buildingId String?
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id])
  site     Site?     @relation(fields: [siteId], references: [id])
  building Building? @relation(fields: [buildingId], references: [id])

  @@unique([userId, role, siteId, buildingId])
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

model StaffProfile {
  id                    String           @id @default(cuid())
  organizationId        String
  userId                String?          @unique
  employeeId            String
  firstName             String
  lastName              String
  phone                 String?
  // Self-editable by the resident (SS-03); employment fields are not.
  emergencyContactName  String?
  emergencyContactPhone String?
  gender                GenderPolicy     @default(ANY)
  department            String?
  company               String?
  employmentStatus      EmploymentStatus @default(ACTIVE)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  organization          Organization           @relation(fields: [organizationId], references: [id])
  user                  User?                  @relation(fields: [userId], references: [id])
  allocations           Allocation[]
  keyTransactions       KeyTransaction[]
  assetAssignments      AssetAssignment[]
  inventoryTransactions InventoryTransaction[]
  lostFoundClaims       LostFoundClaim[]

  @@unique([organizationId, employeeId])
}

model Vendor {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  users        User[]
  workOrders   WorkOrder[]
}

// ---------------------------------------------------------------------------
// Allocation (SRS 8.1)
// ---------------------------------------------------------------------------

enum AllocationStatus {
  DRAFT
  PENDING_APPROVAL
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  REJECTED
  EXPIRED
}

model Allocation {
  id                   String           @id @default(cuid())
  staffId              String
  bedId                String
  startDate            DateTime         @db.Date
  endDate              DateTime?        @db.Date
  status               AllocationStatus @default(DRAFT)
  reason               String?
  requestId            String?
  checkedInAt          DateTime?
  checkedOutAt         DateTime?
  checklist            Json?
  notes                String?
  // Set on the allocation created by a transfer; links old and new records
  // so movement history is traceable (ACM-07).
  previousAllocationId String?
  createdById          String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  staff     StaffProfile @relation(fields: [staffId], references: [id])
  bed       Bed          @relation(fields: [bedId], references: [id])
  request   Request?     @relation(fields: [requestId], references: [id])
  previous  Allocation?  @relation("AllocationChain", fields: [previousAllocationId], references: [id])
  next      Allocation[] @relation("AllocationChain")
  createdBy User?        @relation(fields: [createdById], references: [id])

  @@index([staffId, status])
  @@index([bedId, status])
}

// ---------------------------------------------------------------------------
// Digital forms and approval workflow (SRS 5.4, 8.2)
// ---------------------------------------------------------------------------

model RequestType {
  id             String       @id @default(cuid())
  organizationId String
  code           String
  name           String
  description    String?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  versions     WorkflowVersion[]
  requests     Request[]

  @@unique([organizationId, code])
}

// A request pins the workflow version that was current when it was submitted,
// so editing a form or route never changes in-flight requests.
model WorkflowVersion {
  id            String   @id @default(cuid())
  requestTypeId String
  version       Int
  formSchema    Json
  isCurrent     Boolean  @default(false)
  createdAt     DateTime @default(now())

  requestType RequestType    @relation(fields: [requestTypeId], references: [id])
  steps       ApprovalStep[]
  requests    Request[]

  @@unique([requestTypeId, version])
}

model ApprovalStep {
  id                String  @id @default(cuid())
  workflowVersionId String
  order             Int
  name              String
  approverRole      Role
  requireComment    Boolean @default(false)

  workflowVersion WorkflowVersion    @relation(fields: [workflowVersionId], references: [id])
  decisions       ApprovalDecision[]

  @@unique([workflowVersionId, order])
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  CHANGES_REQUESTED
  RESUBMITTED
  APPROVED
  REJECTED
  FULFILLED
  CLOSED
  CANCELLED
  EXPIRED
}

model Request {
  id                String        @id @default(cuid())
  requestTypeId     String
  workflowVersionId String
  requesterId       String
  idempotencyKey    String        @unique
  data              Json
  status            RequestStatus @default(DRAFT)
  currentStepOrder  Int?
  submissionVersion Int           @default(1)
  decidedAt         DateTime?
  fulfilledAt       DateTime?
  fulfilmentNote    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  requestType     RequestType         @relation(fields: [requestTypeId], references: [id])
  workflowVersion WorkflowVersion     @relation(fields: [workflowVersionId], references: [id])
  requester       User                @relation("RequestRequester", fields: [requesterId], references: [id])
  decisions       ApprovalDecision[]
  submissions     RequestSubmission[]
  allocations     Allocation[]

  @@index([requesterId, status])
  @@index([status])
}

// Every submitted version of the form data is kept, so a request returned
// for changes preserves what was previously submitted (SRS edge case
// "Rejected request resubmitted").
model RequestSubmission {
  id          String   @id @default(cuid())
  requestId   String
  version     Int
  data        Json
  submittedAt DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id])

  @@unique([requestId, version])
}

enum DecisionAction {
  APPROVE
  REJECT
  REQUEST_CHANGES
}

model ApprovalDecision {
  id                String         @id @default(cuid())
  requestId         String
  stepId            String
  approverId        String
  action            DecisionAction
  comment           String?
  submissionVersion Int            @default(1)
  createdAt         DateTime       @default(now())

  request  Request      @relation(fields: [requestId], references: [id])
  step     ApprovalStep @relation(fields: [stepId], references: [id])
  approver User         @relation(fields: [approverId], references: [id])

  @@index([requestId])
}

// ---------------------------------------------------------------------------
// Maintenance (SRS 5.3, 8.3)
// ---------------------------------------------------------------------------

enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkOrderStatus {
  NEW
  TRIAGED
  ASSIGNED
  IN_PROGRESS
  WAITING_STAFF
  WAITING_PARTS
  WAITING_ACCESS
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

model WorkOrder {
  id               String            @id @default(cuid())
  ticketNumber     String            @unique
  siteId           String
  buildingId       String?
  roomId           String?
  category         String
  description      String
  priority         WorkOrderPriority @default(MEDIUM)
  status           WorkOrderStatus   @default(NEW)
  requesterId      String
  assigneeId       String?
  vendorId         String?
  preferredContact String?
  locationNote     String?
  slaDueAt         DateTime?
  acknowledgedAt   DateTime?
  startedAt        DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?
  resolutionNote   String?
  reopenCount      Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  site      Site            @relation(fields: [siteId], references: [id])
  building  Building?       @relation(fields: [buildingId], references: [id])
  room      Room?           @relation(fields: [roomId], references: [id])
  requester User            @relation("WorkOrderRequester", fields: [requesterId], references: [id])
  assignee  User?           @relation("WorkOrderAssignee", fields: [assigneeId], references: [id])
  vendor    Vendor?         @relation(fields: [vendorId], references: [id])
  notes     WorkOrderNote[]

  @@index([status, siteId])
  @@index([assigneeId, status])
}

enum WorkOrderNoteType {
  COMMENT
  STATUS
  ASSIGNMENT
}

model WorkOrderNote {
  id          String            @id @default(cuid())
  workOrderId String
  authorId    String
  type        WorkOrderNoteType @default(COMMENT)
  note        String
  // Internal notes are hidden from the requester and from vendor users.
  internal    Boolean           @default(false)
  createdAt   DateTime          @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  author    User      @relation(fields: [authorId], references: [id])
}

// ---------------------------------------------------------------------------
// Facility booking (SRS 5.5, 8.4)
// ---------------------------------------------------------------------------

model Facility {
  id               String       @id @default(cuid())
  siteId           String
  code             String
  name             String
  location         String?
  description      String?
  capacity         Int          @default(1)
  // Per-day opening hours and booking rules in the site's timezone; see
  // src/modules/facilities/rules.ts for the shapes and defaults (FAC-01, FAC-05).
  openingHours     Json?
  bookingRules     Json?
  requiresApproval Boolean      @default(false)
  status           RecordStatus @default(ACTIVE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  site                  Site                   @relation(fields: [siteId], references: [id])
  bookings              FacilityBooking[]
  keys                  Key[]
  inventoryTransactions InventoryTransaction[]
  assetAssignments      AssetAssignment[]

  @@unique([siteId, code])
}

enum BookingStatus {
  PENDING_APPROVAL
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  REJECTED
  EXPIRED
  NO_SHOW
}

model FacilityBooking {
  id             String        @id @default(cuid())
  facilityId     String
  userId         String
  startsAt       DateTime
  endsAt         DateTime
  headcount      Int           @default(1)
  status         BookingStatus @default(CONFIRMED)
  purpose        String?
  idempotencyKey String?       @unique
  createdById    String?
  decidedById    String?
  decisionNote   String?
  checkedInAt    DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([facilityId, startsAt, endsAt])
  @@index([facilityId, status, startsAt])
  @@index([userId, status, startsAt])
}

// ---------------------------------------------------------------------------
// Key management (SRS 5.6, 8.5)
// ---------------------------------------------------------------------------

enum KeyStatus {
  AVAILABLE
  ISSUED
  LOST
  DAMAGED
  UNDER_REPAIR
  RETIRED
}

model Key {
  id            String    @id @default(cuid())
  siteId        String
  code          String
  label         String?
  roomId        String?
  facilityId    String?
  allowCopies   Boolean   @default(false)
  status        KeyStatus @default(AVAILABLE)
  notes         String?
  // Set on the key that replaced a lost/damaged one (KEY-04).
  replacesKeyId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  site         Site             @relation(fields: [siteId], references: [id])
  room         Room?            @relation(fields: [roomId], references: [id])
  facility     Facility?        @relation(fields: [facilityId], references: [id])
  transactions KeyTransaction[]
  replaces     Key?             @relation("KeyReplacement", fields: [replacesKeyId], references: [id])
  replacedBy   Key[]            @relation("KeyReplacement")

  @@unique([siteId, code])
}

enum KeyTransactionType {
  ISSUE
  RETURN
  LOST
  DAMAGED
  REPAIR
  REPLACED
  RETIRE
}

// Issue/return records are never deleted (KEY-06). An ISSUE row stays open
// (returnedAt null) until the matching RETURN closes it.
model KeyTransaction {
  id               String             @id @default(cuid())
  keyId            String
  type             KeyTransactionType
  holderId         String?
  // Holder outside the staff register (contractor, visitor) when holderId is null.
  holderName       String?
  custodianId      String
  condition        String?
  notes            String?
  expectedReturnAt DateTime?
  returnedAt       DateTime?
  createdAt        DateTime           @default(now())

  key       Key           @relation(fields: [keyId], references: [id])
  holder    StaffProfile? @relation(fields: [holderId], references: [id])
  custodian User          @relation(fields: [custodianId], references: [id])

  @@index([keyId, createdAt])
}

// ---------------------------------------------------------------------------
// Inventory (SRS 5.7)
// ---------------------------------------------------------------------------

enum TrackingType {
  SERIALIZED
  STOCK
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  DAMAGED
  RETIRED
}

model InventoryItem {
  id               String         @id @default(cuid())
  siteId           String
  sku              String
  name             String
  category         String
  description      String?
  unit             String         @default("pcs")
  trackingType     TrackingType   @default(STOCK)
  serialNumber     String?        @unique
  // Stock: units on hand. Serialised asset: 1 while in store, 0 while issued or retired.
  quantity         Int            @default(0)
  reorderThreshold Int?
  storageLocation  String?
  roomId           String?
  condition        AssetCondition @default(GOOD)
  status           RecordStatus   @default(ACTIVE)
  notes            String?
  retiredAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  site          Site                   @relation(fields: [siteId], references: [id])
  room          Room?                  @relation(fields: [roomId], references: [id])
  transactions  InventoryTransaction[] @relation("ItemTransactions")
  counterpartOf InventoryTransaction[] @relation("TransferCounterpart")
  assignments   AssetAssignment[]

  @@unique([siteId, sku, serialNumber])
  @@index([siteId, category])
  @@index([siteId, status, trackingType])
}

enum InventoryTransactionType {
  RECEIPT
  ISSUE
  RETURN
  TRANSFER
  ADJUSTMENT
  DAMAGE
  RETIREMENT
}

// Movement log (INV-02). `quantity` is the signed change to the item's
// on-hand quantity; `balanceAfter` is the on-hand quantity once applied.
model InventoryTransaction {
  id                String                   @id @default(cuid())
  itemId            String
  type              InventoryTransactionType
  quantity          Int
  balanceAfter      Int?
  actorId           String
  roomId            String?
  staffId           String?
  facilityId        String?
  counterpartItemId String?
  condition         AssetCondition?
  reference         String?
  notes             String?
  createdAt         DateTime                 @default(now())

  item        InventoryItem  @relation("ItemTransactions", fields: [itemId], references: [id])
  counterpart InventoryItem? @relation("TransferCounterpart", fields: [counterpartItemId], references: [id])
  actor       User           @relation(fields: [actorId], references: [id])
  room        Room?          @relation(fields: [roomId], references: [id])
  staff       StaffProfile?  @relation(fields: [staffId], references: [id])
  facility    Facility?      @relation(fields: [facilityId], references: [id])

  @@index([itemId, createdAt])
  @@index([createdAt])
  @@index([staffId])
  @@index([roomId])
}

// A serialised asset may have at most one open assignment (partial unique
// index in migration SQL).
model AssetAssignment {
  id           String    @id @default(cuid())
  itemId       String
  roomId       String?
  staffId      String?
  facilityId   String?
  assignedById String
  endedById    String?
  notes        String?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  item       InventoryItem @relation(fields: [itemId], references: [id])
  room       Room?         @relation(fields: [roomId], references: [id])
  staff      StaffProfile? @relation(fields: [staffId], references: [id])
  facility   Facility?     @relation(fields: [facilityId], references: [id])
  assignedBy User          @relation("AssetAssignedBy", fields: [assignedById], references: [id])
  endedBy    User?         @relation("AssetEndedBy", fields: [endedById], references: [id])

  @@index([itemId, endedAt])
  @@index([staffId, endedAt])
  @@index([roomId, endedAt])
  @@index([facilityId, endedAt])
}

// ---------------------------------------------------------------------------
// Lost and found (SRS 5.8)
// ---------------------------------------------------------------------------

enum LostFoundStatus {
  REPORTED
  STORED
  CLAIM_PENDING
  RETURNED
  DISPOSED
}

model LostFoundItem {
  id            String          @id @default(cuid())
  siteId        String
  reference     String          @unique
  description   String
  category      String?
  foundLocation String?
  foundAt       DateTime
  custodianId   String
  status        LostFoundStatus @default(REPORTED)
  handedOverAt  DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  site      Site             @relation(fields: [siteId], references: [id])
  custodian User             @relation(fields: [custodianId], references: [id])
  claims    LostFoundClaim[]
}

enum ClaimOutcome {
  PENDING
  VERIFIED
  REJECTED
}

model LostFoundClaim {
  id              String       @id @default(cuid())
  itemId          String
  claimantId      String?
  claimantName    String?
  claimantContact String?
  evidence        String?
  outcome         ClaimOutcome @default(PENDING)
  decidedAt       DateTime?
  createdAt       DateTime     @default(now())

  item     LostFoundItem @relation(fields: [itemId], references: [id])
  claimant StaffProfile? @relation(fields: [claimantId], references: [id])
}

// ---------------------------------------------------------------------------
// Attachments, notifications, audit
// ---------------------------------------------------------------------------

model Attachment {
  id           String   @id @default(cuid())
  entityType   String
  entityId     String
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  uploadedById String
  createdAt    DateTime @default(now())

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([entityType, entityId])
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

// Outbox: written in the same transaction as the business action, delivered
// by a worker with retries. idempotencyKey prevents duplicate sends (COM-07).
model Notification {
  id                String              @id @default(cuid())
  recipientId       String
  channel           NotificationChannel
  event             String
  template          String
  payload           Json
  idempotencyKey    String              @unique
  status            NotificationStatus  @default(QUEUED)
  attempts          Int                 @default(0)
  lastError         String?
  // Delivery bookkeeping for the worker (COM-04): when to try next, a claim
  // timestamp so concurrent workers never double-send, and what went out.
  nextAttemptAt     DateTime?
  lockedAt          DateTime?
  subject           String?
  deliveredTo       String?
  providerMessageId String?
  sentAt            DateTime?
  readAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  recipient User @relation(fields: [recipientId], references: [id])

  @@index([status, channel, nextAttemptAt])
  @@index([recipientId, readAt])
}

// Append-only (trigger in migration SQL blocks UPDATE/DELETE).
model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  source     String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}
